# Plantilla de Configuración para Desarrolladores (Copiar a .env)
PORT=3500

# Base de Datos PostgreSQL Local de Desarrollo
DB_USER=postgres
DB_PASSWORD=tu_password_local
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=collarnet

# Broker MQTT de Desarrollo
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC_PREFIX=collarnet/dev

# API Key de Gemini (Opcional)
GEMINI_API_KEY=""
